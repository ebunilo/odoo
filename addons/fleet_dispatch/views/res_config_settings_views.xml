<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_fleet_dispatch" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fleet.dispatch</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="fleet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='fleet']" position="inside">
                <block title="Dispatch Accounting" id="fleet_dispatch_accounting">
                    <setting string="Dispatch Products"
                        help="Products used on the vendor bill posted for each dispatch. Their expense accounts receive the fuel cost and the driver cash advance.">
                        <div class="content-group mt16">
                            <div class="row">
                                <label for="dispatch_fuel_product_id" string="Diesel" class="col-lg-4 o_light_label"/>
                                <field name="dispatch_fuel_product_id" context="{'default_type': 'service'}"/>
                            </div>
                            <div class="row">
                                <label for="dispatch_advance_product_id" string="Cash Advance" class="col-lg-4 o_light_label"/>
                                <field name="dispatch_advance_product_id" context="{'default_type': 'service'}"/>
                            </div>
                        </div>
                    </setting>
                    <setting help="Post the vendor bill automatically when a dispatch is confirmed.">
                        <field name="dispatch_auto_post_bill"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
