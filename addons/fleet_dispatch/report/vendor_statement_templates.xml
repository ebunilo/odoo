<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_vendor_statement">
        <t t-call="web.html_container">
            <t t-set="st" t-value="statement"/>
            <t t-set="o" t-value="st['partner']"/>
            <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': currency}"/>
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Fuel Vendor Statement</h2>
                    <div class="row mt-3 mb-3">
                        <div class="col-5">
                            <strong>Vendor:</strong>
                            <div t-field="o.self" t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': True}"/>
                        </div>
                        <div class="col-4">
                            <strong>Period:</strong><br/>
                            <span t-out="data['form']['date_from'] or 'Beginning'"/>
                            to
                            <span t-out="data['form']['date_to'] or 'Today'"/>
                        </div>
                        <div class="col-3">
                            <strong>Target Moves:</strong><br/>
                            <span t-if="data['form']['target_move'] == 'posted'">Posted Entries</span>
                            <span t-else="">All Entries</span>
                        </div>
                    </div>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Entry</th>
                                <th>Dispatch No.</th>
                                <th>Truck No.</th>
                                <th>Driver</th>
                                <th>Description</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="fw-bold">
                                <td colspan="8">Opening Balance</td>
                                <td class="text-end"><span t-out="st['opening']" t-options="money"/></td>
                            </tr>
                            <tr t-foreach="st['lines']" t-as="line">
                                <td><span t-out="line['date']" t-options="{'widget': 'date'}"/></td>
                                <td><span t-out="line['move_name']"/></td>
                                <td><span t-out="line['dispatch']"/></td>
                                <td><span t-out="line['truck']"/></td>
                                <td><span t-out="line['driver']"/></td>
                                <td>
                                    <span t-out="line['ref'] or line['label']"/>
                                    <t t-if="line['destination']"> – <span t-out="line['destination']"/></t>
                                </td>
                                <td class="text-end"><span t-out="line['debit']" t-options="money"/></td>
                                <td class="text-end"><span t-out="line['credit']" t-options="money"/></td>
                                <td class="text-end"><span t-out="line['balance']" t-options="money"/></td>
                            </tr>
                            <tr class="fw-bold border-top">
                                <td colspan="6">Totals / Closing Balance</td>
                                <td class="text-end"><span t-out="st['total_debit']" t-options="money"/></td>
                                <td class="text-end"><span t-out="st['total_credit']" t-options="money"/></td>
                                <td class="text-end"><span t-out="st['closing']" t-options="money"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="text-muted small">
                        A negative balance is the amount owed to the vendor.
                    </p>

                    <t t-if="st['trucks']">
                        <h4 class="mt-4">Trips per Truck</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Truck No.</th>
                                    <th class="text-end">Trips</th>
                                    <th class="text-end">Diesel (L)</th>
                                    <th class="text-end">Fuel Cost</th>
                                    <th class="text-end">Cash Advance</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="st['trucks']" t-as="truck">
                                    <td><span t-out="truck[0]"/></td>
                                    <td class="text-end"><span t-out="truck[1]['trips']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % truck[1]['litres']"/></td>
                                    <td class="text-end"><span t-out="truck[1]['fuel']" t-options="money"/></td>
                                    <td class="text-end"><span t-out="truck[1]['advance']" t-options="money"/></td>
                                    <td class="text-end"><span t-out="truck[1]['fuel'] + truck[1]['advance']" t-options="money"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
